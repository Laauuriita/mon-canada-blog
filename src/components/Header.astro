---
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: "/", label: "Accueil" },
  { href: "/blog", label: "Blog" },
  { href: "/a-propos", label: "À propos" },
  { href: "/contact", label: "Contact", cta: true },
];
---
<header class="site-header">
  <div class="header-inner">
    <a href="/" class="logo" aria-label="Comme des Écureuils — Accueil">
      <span class="logo-title">
        <svg width="22" height="22" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" style="display:inline-block;vertical-align:middle;margin-right:6px;">
          <circle cx="16" cy="16" r="15" fill="rgba(0,212,176,0.15)" stroke="rgba(0,212,176,0.4)" stroke-width="1.5"/>
          <!-- Corps écureuil stylisé -->
          <ellipse cx="16" cy="19" rx="5.5" ry="6" fill="#00d4b0" opacity="0.9"/>
          <!-- Tête -->
          <circle cx="16" cy="12" r="4" fill="#00d4b0" opacity="0.9"/>
          <!-- Queue touffue -->
          <path d="M20.5 20 Q28 16 26 10 Q24 6 20 9 Q22 13 20 17Z" fill="#00d4b0" opacity="0.7"/>
          <!-- Oreilles -->
          <ellipse cx="13.5" cy="9" rx="1.8" ry="2.5" fill="#00d4b0" opacity="0.9" transform="rotate(-15 13.5 9)"/>
          <ellipse cx="18.5" cy="9" rx="1.8" ry="2.5" fill="#00d4b0" opacity="0.9" transform="rotate(15 18.5 9)"/>
          <!-- Œil -->
          <circle cx="14.8" cy="11.8" r="0.9" fill="#091420"/>
          <circle cx="17.2" cy="11.8" r="0.9" fill="#091420"/>
          <!-- Noisette -->
          <ellipse cx="16" cy="22" rx="2" ry="1.5" fill="#091420" opacity="0.4"/>
        </svg>
        Comme des Écureuils
      </span>
      <span class="logo-subtitle">Le Canada comme on ne vous l'a jamais raconté</span>
    </a>
    <nav class="main-nav" aria-label="Navigation principale">
      {navLinks.map(link => (
        <a
          href={link.href}
          class:list={[
            "nav-link",
            { active: currentPath === link.href || (link.href !== "/" && currentPath.startsWith(link.href)) },
            { cta: link.cta }
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>
