---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf())
  .slice(0, 3);
---
<Layout
  title="Accueil"
  description="Blog de voyage sur le Canada — une nageuse sauveteur et un bûcheron explorent le Québec, ses forêts géantes, ses hivers polaires et ses paysages sauvages."
>

  <!-- HERO avec vraie photo -->
  <section class="hero">
    <img
      src="https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1600&q=80&auto=format&fit=crop"
      alt="Lac Louise dans les Rocheuses canadiennes"
      class="hero-bg"
      loading="eager"
    />
    <div class="hero-content">
      <span class="hero-eyebrow">🐿️ Comme des Écureuils — Blog Canada</span>
      <h1>
        Le Canada,
        <span class="accent">comme des écureuils</span>
      </h1>
      <p>
        Une nageuse sauveteur et un bûcheron débarquent au Québec avec leurs valises
        et beaucoup de curiosité. On explore, on rigole, on se perd dans les forêts — et on vous raconte tout.
      </p>
      <div class="hero-actions">
        <a href="/blog" class="btn btn-primary">Lire le blog</a>
        <a href="/a-propos" class="btn btn-outline">Notre histoire</a>
      </div>
    </div>
  </section>

  <!-- THÈMES -->
  <section class="section section-alt">
    <div class="container">
      <div class="theme-grid">
        {[
          { icon: "🌲", title: "Nature sauvage", text: "Des forêts boréales aux Rocheuses, des paysages qui changent le regard." },
          { icon: "🍁", title: "Vie au Québec", text: "La belle province vue de l'intérieur — ses saisons, ses habitants, ses traditions." },
          { icon: "🏔️", title: "Aventures", text: "Randonnées, raquettes, kayak... le Canada ça se vit debout." },
          { icon: "🧭", title: "Conseils pratiques", text: "Visa, budget, météo, transports : tout pour voyager sereinement." },
        ].map(item => (
          <div class="theme-card">
            <div class="icon">{item.icon}</div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- DERNIERS ARTICLES -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2>Derniers articles</h2>
        <p>Les aventures canadiennes les plus récentes, directement depuis le terrain.</p>
        <div class="divider"></div>
      </div>
      <div class="cards-grid">
        {recentPosts.map(post => (
          <article class="card">
            <div class="card-image-placeholder" style={`background: ${post.data.bgColor || 'linear-gradient(135deg, #0d2a1a, #0a1e2e)'}`}>
              {post.data.emoji || '🍁'}
            </div>
            <div class="card-body">
              <span class="card-category">{post.data.category}</span>
              <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
              <div class="card-meta">
                <span>{new Date(post.data.pubDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
                <span>·</span>
                <span>{post.data.readTime} min de lecture</span>
              </div>
              <a href={`/blog/${post.id}`} class="card-read-more">Lire l'article</a>
            </div>
          </article>
        ))}
      </div>
      <div style="text-align: center; margin-top: 3rem;">
        <a href="/blog" class="btn btn-outline">Voir tous les articles</a>
      </div>
    </div>
  </section>

  <!-- PHOTO BANDE -->
  <div style="display:grid; grid-template-columns: repeat(3,1fr); height: 240px; overflow:hidden;">
    <img
      src="https://images.unsplash.com/photo-1448375240586-882707db888b?w=600&q=75&auto=format&fit=crop"
      alt="Forêt boréale canadienne"
      style="width:100%;height:100%;object-fit:cover;"
    />
    <img
      src="https://images.unsplash.com/photo-1531366936337-7c912a4589a7?w=600&q=75&auto=format&fit=crop"
      alt="Aurores boréales au Canada"
      style="width:100%;height:100%;object-fit:cover;"
    />
    <img
      src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=600&q=75&auto=format&fit=crop"
      alt="Paysage montagneux canadien"
      style="width:100%;height:100%;object-fit:cover;"
    />
  </div>

  <!-- CTA -->
  <section class="section section-dark">
    <div class="container">
      <div class="cta-section">
        <div style="font-size: 2.5rem; margin-bottom: 1rem;">🐿️</div>
        <h2>Une question ? Une envie de partager ?</h2>
        <p>
          Tu prépares un voyage au Canada, tu veux des conseils ou simplement discuter ?
          Je lis tous mes messages avec plaisir.
        </p>
        <a href="/contact" class="btn btn-primary">Me contacter</a>
      </div>
    </div>
  </section>

</Layout>
