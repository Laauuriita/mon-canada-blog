---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = await getCollection('blog');
const otherPosts = allPosts
  .filter(p => p.id !== post.id)
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf())
  .slice(0, 2);

// Image de couverture par défaut selon la catégorie
const heroImages: Record<string, string> = {
  'Hiver': 'https://images.unsplash.com/photo-1516912481808-3406841bd33c?w=1600&q=80&auto=format&fit=crop',
  'Automne': 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=1600&q=80&auto=format&fit=crop',
  'Nature': 'https://images.unsplash.com/photo-1448375240586-882707db888b?w=1600&q=80&auto=format&fit=crop',
  'Gastronomie': 'https://images.unsplash.com/photo-1448375240586-882707db888b?w=1600&q=80&auto=format&fit=crop',
};
const heroImg = post.data.heroImage || heroImages[post.data.category] || 'https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=1600&q=80&auto=format&fit=crop';
---
<Layout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
>

  <!-- HERO ARTICLE plein cadre -->
  <div class="article-hero">
    <img
      src={heroImg}
      alt={post.data.title}
      class="article-hero-img"
      loading="eager"
    />
    <div class="article-hero-content">
      <p class="breadcrumb">
        <a href="/">Accueil</a> › <a href="/blog">Blog</a> › {post.data.title}
      </p>
      <span class="card-category" style="margin-bottom: 1rem; display: inline-block;">{post.data.category}</span>
      <h1>{post.data.title}</h1>
      <div class="article-meta">
        <span class="author-chip">✍️ Laura</span>
        <span>📅 {new Date(post.data.pubDate).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
        <span>⏱️ {post.data.readTime} min de lecture</span>
      </div>
      {post.data.tags && (
        <div style="margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 0.5rem;">
          {post.data.tags.map((tag: string) => (
            <span style="font-size: 0.75rem; background: rgba(0,212,176,0.1); color: var(--color-teal); padding: 0.2rem 0.65rem; border-radius: 20px; border: 1px solid var(--color-teal-border);">#{tag}</span>
          ))}
        </div>
      )}
    </div>
  </div>

  <!-- CONTENU -->
  <div class="article-content">
    <Content />
  </div>

  <!-- À LIRE AUSSI -->
  {otherPosts.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <h2 style="font-size: 1.4rem; margin-bottom: 2rem; text-align: center;">À lire aussi</h2>
        <div class="cards-grid" style="max-width: 760px; margin: 0 auto;">
          {otherPosts.map(p => (
            <article class="card">
              <div class="card-image-placeholder" style={`background: ${p.data.bgColor || 'linear-gradient(135deg, #0d2a1a, #0a1e2e)'}`}>
                {p.data.emoji || '🍁'}
              </div>
              <div class="card-body">
                <span class="card-category">{p.data.category}</span>
                <h3><a href={`/blog/${p.id}`}>{p.data.title}</a></h3>
                <p>{p.data.description.substring(0, 100)}...</p>
                <a href={`/blog/${p.id}`} class="card-read-more">Lire l'article</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- NAV -->
  <div class="article-nav">
    <a href="/blog" class="btn btn-outline">← Retour au blog</a>
    <a href="/contact" class="btn btn-primary">Réagir à cet article</a>
  </div>

</Layout>
